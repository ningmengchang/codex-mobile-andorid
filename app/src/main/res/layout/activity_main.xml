<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/setupScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Codex 随行"
                android:src="@drawable/ic_app" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Codex 随行"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="连接电脑后，直接遥控现有 Codex Mobile"
                android:textColor="#9917201D"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SSH 连接"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="电脑地址"
                    android:textColor="#B317201D"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/hostInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="例如 192.168.1.10 或域名"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="SSH 端口"
                            android:textColor="#B317201D"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/sshPortInput"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:inputType="number"
                            android:importantForAutofill="no"
                            android:maxLines="1"
                            android:text="22"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="14dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="SSH 用户名"
                            android:textColor="#B317201D"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/usernameInput"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="电脑登录用户"
                            android:autofillHints="username"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="登录方式"
                    android:textColor="#B317201D"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/authModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="46dp" />

                <TextView
                    android:id="@+id/secretLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="SSH 密码"
                    android:textColor="#B317201D"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/secretInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="仅加密保存在这台手机"
                    android:autofillHints="password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/privateKeyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/importKeyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="导入私钥"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/keyStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text="尚未导入"
                        android:textColor="#9917201D"
                        android:textSize="12sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/rememberSecretCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="加密保存密码或私钥口令"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/autoConnectCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="打开 App 时自动连接"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="服务端口（电脑 / 手机）"
                    android:textColor="#B317201D"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/remotePortInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="电脑端口"
                        android:inputType="number"
                        android:importantForAutofill="no"
                        android:maxLines="1"
                        android:text="3765"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="→"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/localPortInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="手机端口"
                        android:inputType="number"
                        android:importantForAutofill="no"
                        android:maxLines="1"
                        android:text="3765"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/setupStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#C53A2D"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/disconnectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="断开"
                        android:textAllCaps="false"
                        android:visibility="gone" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/connectButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/codex_green"
                        android:text="保存并连接"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="首次连接会要求核对 SSH 指纹；指纹变化时 App 会阻止连接。"
                android:textColor="#8017201D"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:indeterminateTint="@color/codex_green" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="正在连接电脑…"
            android:textColor="@color/ink"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shareProgressPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:background="@drawable/panel_background"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shareProgressText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="2"
                android:text="正在准备文件…"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <Button
                android:id="@+id/cancelShareButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="取消"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/shareProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:max="100"
            android:progressTint="@color/codex_green" />
    </LinearLayout>

</FrameLayout>
